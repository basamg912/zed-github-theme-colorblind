set number
syntax enable
set vb t_vb=
filetype plugin indent on
set autoindent
set smartindent
set expandtab
set tabstop=4
set shiftwidth=4
set softtabstop=4
set backspace=indent,eol,start
set encoding=utf-8
set fileencoding=utf-8
set nocursorline
set foldmethod=syntax
set foldlevel=999
set ttimeoutlen=50
autocmd FileType * setlocal formatoptions-=r formatoptions-=o
set hlsearch
set ignorecase
set smartcase
set incsearch
set scrolloff=5
set ruler
set wildmenu
nnoremap <F5> :w<CR>:!g++-16 -std=c++17 -O2 % -o %< && ./%<<CR>
